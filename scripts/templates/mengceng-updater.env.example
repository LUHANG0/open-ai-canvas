# Host-only template. Replace paths from the target inventory and generate the
# token privately; never use this example as an actual EnvironmentFile.
CANVAS_UPDATER_TOKEN=<private-random-token-at-least-32-characters>
CANVAS_UPDATER_CUSTOM_PROFILE=/etc/mengceng-updater/profile.json
CANVAS_UPDATER_REPOSITORY=LUHANG0/open-ai-canvas
CANVAS_UPDATER_STATE_DIR=/var/lib/mengceng-updater
CANVAS_UPDATER_BACKUP_DIR=/opt/mengceng/backups/host-updater
CANVAS_UPDATER_SOCKET=/run/mengceng-updater/updater.sock
# Current site example; verify the actual bound port before installation.
CANVAS_UPDATER_HEALTH_URL=http://127.0.0.1:18300/api/health/ready
CANVAS_UPDATER_STABLE_WINDOW=30s
CANVAS_UPDATER_STEP_TIMEOUT=20m
CANVAS_UPDATER_BINARY_PATH=/usr/local/bin/mengceng-host-updater
CANVAS_UPDATER_SERVICE_NAME=mengceng-updater.service
CANVAS_UPDATER_SELF_UPDATE=false
MENGCENG_WEB_PUBLISHER_CONFIG=/etc/mengceng-updater/web-publisher.json
